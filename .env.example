# ============ LLM 网关（OpenAI 兼容） ============
# 承载 glm / DeepSeek / Qwen 等多个模型的网关地址与 API key。
GATEWAY_BASE_URL=https://api.upmore.net/v1
GATEWAY_API_KEY=
# 网关提供的模型名（CrewAI agent 使用）。
GATEWAY_MAIN_MODEL=glm-5.3
GATEWAY_FAST_MODEL=glm-5.3-flash
# 可选调优：每次 LLM 调用的超时（秒）；回复 agent 的 temperature
# 覆盖（调试幻觉时用）；拒绝 tool_choice 的思考型模型（逗号分隔
# 子串匹配，命中的回退 JSON 模式结构化输出）。
#LLM_TIMEOUT_SEC=180
#RESPONSE_TEMPERATURE=0.3
NO_TOOL_CHOICE_MODELS=deepseek-v4,qwen3.8,kimi-k2,kimi-k3

# ============ 嵌入模型（fastembed，本地 ONNX） ============
# 模型首次使用时下载；Hugging Face 访问不了时设
# HF_ENDPOINT=https://hf-mirror.com 走镜像。
# 稠密：bge-small 语义向量（中文为主用 zh，英文为主用 en）；
# 稀疏：Qdrant/bm25 接 jieba 分词；重排：bge-reranker-base 交叉编码器。
# 全部本地 CPU 运行——混合检索（dense+sparse RRF 融合 + 重排）开箱即用。
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
SPARSE_MODEL_NAME=Qdrant/bm25
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# ============ Qdrant ============
QDRANT_LOCATION=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=obsidian-notes

# ============ Obsidian 笔记库 ============
OBSIDIAN_VAULT_PATH=/path/to/vault
# 笔记库顶层文件夹，逗号分隔。INCLUDE 留空 = 全部文件夹；EXCLUDE
# 默认排除回收站（.trash）和程序配置目录（.obsidian），可按需增删。
#OBSIDIAN_INCLUDE_FOLDERS=
OBSIDIAN_EXCLUDE_FOLDERS=.trash,.obsidian
# 跳过 frontmatter 含以下键的笔记（逗号分隔）。默认排除 Excalidraw
# 画板（压缩数据块，不是正文）。
OBSIDIAN_EXCLUDE_FRONTMATTER=excalidraw-plugin

# ============ 其他 ============
# AgentOps 可观测性（不用就留空）
AGENTOPS_API_KEY=
# 关闭 CrewAI 内置 trace 上传（不再访问 app.crewai.com），全自动运行请保持
# false。注意：此开关不抑制首次运行的 20s「查看执行 trace」提示（CrewAI
# 首次同意机制）——要连提示一起关掉，另执行一次 `crewai traces disable`。
CREWAI_TRACING_ENABLED=false
# 出网代理（Gmail / Qdrant Cloud 访问用），由 config.py 加载，
# 无需 shell export。无代理网络环境删掉即可。
#HTTPS_PROXY=http://127.0.0.1:7897
