# LLM gateway (OpenAI-compatible)
# Base URL and API key of the gateway serving DeepSeek models.
GATEWAY_BASE_URL=https://api.upmore.net/v1
GATEWAY_API_KEY=
# Model names served by the gateway (used by the CrewAI agents).
GATEWAY_MAIN_MODEL=deepseek-v4-pro
GATEWAY_FAST_MODEL=deepseek-v4-flash

# Local embedding (fastembed)
# The model is downloaded on first use. Set HF_ENDPOINT=https://hf-mirror.com
# if Hugging Face is unreachable from your network.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Qdrant configuration
QDRANT_LOCATION=http://localhost:6333
QDRANT_API_KEY=

# Observability with AgentOps
# Leave empty if you don't want to use AgentOps
AGENTOPS_API_KEY=

# Obsidian configuration
OBSIDIAN_VAULT_PATH=/path/to/vault
